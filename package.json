{
  "name": "blendproof",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "BLENDPROOF_PAIRING_CODE=blendproof-local-dev-pairing-code-01 VITE_LOCAL_BRIDGE_PAIRING_CODE=blendproof-local-dev-pairing-code-01 concurrently -k \"npm:dev:web\" \"npm:dev:server\" \"npm:dev:worker\"",
    "dev:web": "vite --host localhost --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "dev:worker": "wrangler dev --local --port 8787 --var APP_ORIGIN:http://localhost:5173",
    "build": "tsc -b && vite build && npm run build:landing",
    "build:app": "tsc -b && BLENDPROOF_PRESERVE_DIST=1 vite build",
    "build:landing": "vite build --config landing/vite.config.ts",
    "build:all": "npm run build",
    "start": "tsx server/index.ts",
    "create:test-blend": "BLENDER_BIN=\"/Users/tanyancong/Library/Application Support/Steam/steamapps/common/Blender/Blender.app/Contents/MacOS/Blender\" tsx server/create-test-blend.ts",
    "create:viewer-fixtures": "BLENDER_BIN=\"/Users/tanyancong/Library/Application Support/Steam/steamapps/common/Blender/Blender.app/Contents/MacOS/Blender\" tsx server/create-viewer-fixtures.ts",
    "check": "tsc -b --pretty false",
    "optimize:landing-images": "node scripts/optimize-landing-images.mjs",
    "test:review-api": "tsx --test tests/review-api.test.ts",
    "test:landing": "npm run build:landing && npm run test:landing:built",
    "test:landing:built": "node tests/landing-smoke.mjs && node --test tests/landing-loading.test.mjs",
    "test:backend": "tsx --test tests/blendproof-client.test.ts tests/db.test.ts tests/legacy-migration.test.ts tests/local-storage.test.ts tests/review-api.test.ts tests/viewer.test.ts",
    "check:worker": "tsc -p tsconfig.worker.json --pretty false",
    "check:arch": "node scripts/check-architecture.mjs",
    "test:worker": "vitest run --config vitest.config.mts",
    "worker:types": "wrangler types",
    "worker:dev": "wrangler dev --local",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "verify:release": "bash scripts/verify-release.sh",
    "verify:release-assets": "node scripts/verify-release-assets.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "deploy:production": "bash scripts/deploy-production.sh",
    "deploy:actions": "bash scripts/deploy-via-actions.sh",
    "ship": "bash scripts/ship.sh",
    "test:release-pipeline": "node --test tests/release-pipeline.test.mjs tests/clean-task.test.mjs",
    "clean:task": "node scripts/clean-task.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "aws4fetch": "^1.0.20",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^5.10.0",
    "jsblender": "^0.0.4",
    "lucide-react": "^0.554.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "sharp": "^0.35.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  }
}
