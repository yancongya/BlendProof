{
  "name": "blendproof",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "BLENDPROOF_PAIRING_CODE=blendproof-local-dev-pairing-code-01 VITE_LOCAL_BRIDGE_PAIRING_CODE=blendproof-local-dev-pairing-code-01 concurrently -k \"npm:dev:web\" \"npm:dev:server\" \"npm:dev:worker\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "dev:worker": "wrangler dev --local --port 8787",
    "build": "tsc -b && vite build && npm run build:landing",
    "build:app": "tsc -b && vite build",
    "build:landing": "vite build --config landing/vite.config.ts",
    "build:all": "npm run build",
    "start": "tsx server/index.ts",
    "create:test-blend": "BLENDER_BIN=\"/Users/tanyancong/Library/Application Support/Steam/steamapps/common/Blender/Blender.app/Contents/MacOS/Blender\" tsx server/create-test-blend.ts",
    "create:viewer-fixtures": "BLENDER_BIN=\"/Users/tanyancong/Library/Application Support/Steam/steamapps/common/Blender/Blender.app/Contents/MacOS/Blender\" tsx server/create-viewer-fixtures.ts",
    "check": "tsc -b --pretty false",
    "test:review-api": "tsx --test tests/review-api.test.ts",
    "test:backend": "tsx --test tests/blendproof-client.test.ts tests/db.test.ts tests/legacy-migration.test.ts tests/local-storage.test.ts tests/review-api.test.ts",
    "check:worker": "tsc -p tsconfig.worker.json --pretty false",
    "test:worker": "vitest run --config vitest.config.mts",
    "worker:types": "wrangler types",
    "worker:dev": "wrangler dev --local",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist-worker"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "jsblender": "^0.0.4",
    "lucide-react": "^0.554.0",
    "multer": "^2.0.2",
    "postprocessing": "^6.39.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  }
}
