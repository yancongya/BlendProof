# Copy to .dev.vars for local Worker upload development only.
# Configure production values with `wrangler secret put <NAME>`.
UPLOAD_SIGNING_SECRET="replace-with-at-least-32-random-characters"
SHARE_ACCESS_SECRET="replace-with-an-independent-32-character-secret"

# Self-hosted identity defaults. Keep the bundled local account system unless
# this deployment has its own compatible external identity provider.
UNIVERSAL_AUTH_MODE="off"
IDENTITY_PROVIDER_NAME="Local account"
ENABLE_DEMO_ACCOUNT="false"

# Object storage defaults to the Wrangler ASSETS R2 binding.
# To use an AWS SigV4 compatible private bucket, uncomment the provider and
# endpoint values, then keep access credentials in .dev.vars / Worker Secrets.
# STORAGE_PROVIDER="s3"
# S3_ENDPOINT="https://s3.example.com/private-bucket"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="replace-with-storage-access-key"
# S3_SECRET_ACCESS_KEY="replace-with-storage-secret-key"
# S3_SESSION_TOKEN="optional-temporary-session-token"
