{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blendproof-api-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blendproof-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "blendproof-local"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "BOOTSTRAP_ADMIN_EMAIL": "admin@blendproof.local",
    "BOOTSTRAP_ADMIN_NAME": "本地管理员"
  }
}
