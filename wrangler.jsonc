{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blendproof",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blendproof-production",
      "database_id": "84e3858e-0a7e-4199-8ac1-40e7339c1474",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "blendproof-production"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "routes": [
    {
      "pattern": "blendproof.itycon.cn",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "APP_ORIGIN": "https://blendproof.itycon.cn"
    // BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_NAME 不写入仓库，改由 Cloudflare
    // 控制台的 Worker 变量配置。它们是空库一次性 bootstrap 的输入，接口在
    // 首位管理员创建成功后即永久关闭，因此仓库无需保留其值。
  }
}
